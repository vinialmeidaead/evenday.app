# Database
DATABASE_URL="postgresql://user:password@localhost:5432/evenday_certificates?schema=public"

# evenday.app API
EVENDAY_API_URL="http://localhost:8000"
EVENDAY_API_KEY=""

# NextAuth / Session
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Storage (AWS S3 or compatible)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="evenday-certificates"

# Storage Mode: "s3" or "local"
STORAGE_MODE="local"

# Node Environment
NODE_ENV="development"
