# ============================================
# DOCKER - Variáveis de Ambiente
# ============================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@postgres:5432/evenday?schema=public"
DIRECT_URL="postgresql://user:password@postgres:5432/evenday?schema=public"

# API Externa Evenday
EVDAY_API_URL="https://api.evenday.com"
EVDAY_API_KEY="your-api-key-here"

# Storage Provider (local, s3, wasabi)
STORAGE_PROVIDER="local"

# AWS S3 / Wasabi S3 Configuration
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="evenday-certificates"
S3_ENDPOINT="https://s3.wasabisys.com"
STORAGE_PUBLIC_URL="https://your-bucket.s3.wasabisys.com"

# Next.js
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"
